# Local config — copy gauge.config.example.json → gauge.config.json
# and point it at your own projects. The real one stays out of git.
gauge.config.json
dashboard.config.json
.gauge/

# Local Claude Code / jig state (machine-specific, not part of the project)
.claude/
.jig/

# Synthetic scanner input: keep real Claude state ignored while allowing the
# worktree-only regression fixture to model the on-disk shape.
!test/fixtures/proj-jig/.claude/
!test/fixtures/proj-jig/.claude/**

# >>> jig secret-ignore >>>
# jig secret-prevention floor (ADR-0013) — git-ignore common secret
# files so they can't be staged by accident. Edit above/below the
# markers; this block is regenerated by jig and re-runs are idempotent.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
*.pem
*.key
secrets/
credentials/
.jig/semantic-index-claude-hook.json
.jig/semantic-index-codex-hook.json
.jig/semantic-index-events.jsonl
.jig/servo-hint-shown
# <<< jig secret-ignore <<<

# servo design-eval tooling (scoped, dev-only; see ADR-0001 note)
.servo/design-eval/node_modules/
.servo/design-eval/shots/
.servo/design-eval/ledger.jsonl
